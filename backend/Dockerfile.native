# Stage 1 — Build native binary with Mandrel JDK 25
FROM quay.io/quarkus/ubi-quarkus-mandrel-builder-image:jdk-25 AS build
USER root
WORKDIR /workspace
COPY backend/pom.xml backend/pom.xml
COPY backend/.mvn backend/.mvn
COPY backend/mvnw backend/mvnw
COPY backend/src backend/src
WORKDIR /workspace/backend
RUN chmod +x mvnw && ./mvnw package -Dnative -DskipTests -q

# Stage 2 — Minimal runtime image (~9 MB base)
FROM quay.io/quarkus/quarkus-micro-image:2.0
WORKDIR /work/
COPY --from=build /workspace/backend/target/*-runner /work/application
RUN chmod 775 /work/application \
    && chown 1001 /work/application
USER 1001
EXPOSE 8080
CMD ["./application", "-Dquarkus.http.host=0.0.0.0"]
